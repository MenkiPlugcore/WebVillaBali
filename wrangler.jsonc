{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webvillabali",
  "main": "worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/sitemap.xml", "/property", "/property/", "/property.html", "/properties/*", "/pay", "/pay/", "/pay.html", "/admin", "/admin/*", "/dev", "/dev/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
